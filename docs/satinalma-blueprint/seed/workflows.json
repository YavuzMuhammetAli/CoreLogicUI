{
  "$comment": "5 workflow tanimi. Satin alma talebi onayi artik TEK akis (PR_ONAY): kademe secimi kosul dugumleriyle akis icinde yapilir — eski PR_ONAY_K1..K4 (dort ayri tanim, birbirini dislayan tetik araliklari) kaldirildi. Tam gerekce: ../08-workflow-tasarimi.md. roleId degerleri publish-all.ps1 tarafindan calisma aninda /Role listesinden cozulur (bkz. roles.json workflowRoleMapping).",
  "version": "1.0",
  "$criticalNote": "Kademe yollari: <10.000 Departman; 10.000-50.000 Departman -> Satin alma; 50.000-250.000 Satin alma -> Finans; >=250.000 Satin alma -> Finans -> Genel mudur. Sinir degerleri kosul dugumlerinde; tek akis oldugu icin tetik araliklarinin kesismemesi gibi bir kural artik yok.",
  "workflows": [
    {
      "name": "Satin Alma Talebi Onayi",
      "code": "PR_ONAY",
      "modelName": "PurchaseRequest",
      "triggerEvent": "onUpdate",
      "isEnabled": true,
      "amountRange": "Tum tutarlar — kademe secimi akis icinde, kosul dugumleriyle",
      "triggerConditionJson": [
        {
          "field": "Status",
          "operator": "eq",
          "value": "Submitted"
        }
      ],
      "definitionJson": {
        "startStep": "giris",
        "entityStatusMap": {
          "dept": "Departman Muduru Onayinda",
          "purchasing": "Satin Alma Muduru Onayinda",
          "finance": "Finans Muduru Onayinda",
          "management": "Genel Mudur Onayinda"
        },
        "steps": [
          {
            "key": "giris",
            "type": "condition",
            "name": "Departman onayi gerekli mi? (< 50.000)",
            "cases": [
              {
                "key": "evet",
                "label": "50.000 alti",
                "match": "all",
                "when": [
                  {
                    "field": "TotalAmountTry",
                    "operator": "lt",
                    "value": "50000"
                  }
                ],
                "to": "dept"
              }
            ],
            "defaultTo": "purchasing"
          },
          {
            "key": "dept",
            "type": "approval",
            "name": "Departman Muduru Onayi",
            "assignment": {
              "mode": "role",
              "roleId": 6
            },
            "sla": {
              "dueHours": 48,
              "escalateAfterHours": 72,
              "onTimeout": "escalate"
            },
            "form": {
              "fields": [
                {
                  "name": "Comment",
                  "dataType": "string",
                  "isRequired": false,
                  "label": "Aciklama"
                },
                {
                  "name": "BudgetChecked",
                  "dataType": "boolean",
                  "isRequired": true,
                  "label": "Butce kontrol edildi"
                }
              ]
            },
            "onApprove": "satinalmaGerekli",
            "onReject": "red"
          },
          {
            "key": "satinalmaGerekli",
            "type": "condition",
            "name": "Satin alma onayi gerekli mi? (>= 10.000)",
            "cases": [
              {
                "key": "evet",
                "label": "10.000 ve uzeri",
                "match": "all",
                "when": [
                  {
                    "field": "TotalAmountTry",
                    "operator": "ge",
                    "value": "10000"
                  }
                ],
                "to": "purchasing"
              }
            ],
            "defaultTo": "onay"
          },
          {
            "key": "purchasing",
            "type": "approval",
            "name": "Satin Alma Muduru Onayi",
            "assignment": {
              "mode": "role",
              "roleId": 2
            },
            "sla": {
              "dueHours": 48,
              "escalateAfterHours": 96,
              "onTimeout": "escalate"
            },
            "form": {
              "fields": [
                {
                  "name": "Comment",
                  "dataType": "string",
                  "isRequired": false,
                  "label": "Aciklama"
                },
                {
                  "name": "SuggestedSupplier",
                  "dataType": "string",
                  "isRequired": false,
                  "label": "Onerilen Tedarikci"
                }
              ]
            },
            "onApprove": "finansGerekli",
            "onReject": "red"
          },
          {
            "key": "finansGerekli",
            "type": "condition",
            "name": "Finans onayi gerekli mi? (>= 50.000)",
            "cases": [
              {
                "key": "evet",
                "label": "50.000 ve uzeri",
                "match": "all",
                "when": [
                  {
                    "field": "TotalAmountTry",
                    "operator": "ge",
                    "value": "50000"
                  }
                ],
                "to": "finance"
              }
            ],
            "defaultTo": "onay"
          },
          {
            "key": "finance",
            "type": "approval",
            "name": "Finans Muduru Onayi",
            "assignment": {
              "mode": "role",
              "roleId": 4
            },
            "sla": {
              "dueHours": 72,
              "escalateAfterHours": 120,
              "onTimeout": "escalate"
            },
            "form": {
              "fields": [
                {
                  "name": "Comment",
                  "dataType": "string",
                  "isRequired": true,
                  "label": "Mali Degerlendirme"
                },
                {
                  "name": "BudgetAvailable",
                  "dataType": "boolean",
                  "isRequired": true,
                  "label": "Butce Uygun"
                }
              ]
            },
            "onApprove": "yonetimGerekli",
            "onReject": "red"
          },
          {
            "key": "yonetimGerekli",
            "type": "condition",
            "name": "Genel mudur onayi gerekli mi? (>= 250.000)",
            "cases": [
              {
                "key": "evet",
                "label": "250.000 ve uzeri",
                "match": "all",
                "when": [
                  {
                    "field": "TotalAmountTry",
                    "operator": "ge",
                    "value": "250000"
                  }
                ],
                "to": "management"
              }
            ],
            "defaultTo": "onay"
          },
          {
            "key": "management",
            "type": "approval",
            "name": "Genel Mudur Onayi",
            "assignment": {
              "mode": "role",
              "roleId": 9
            },
            "sla": {
              "dueHours": 120,
              "escalateAfterHours": 168,
              "onTimeout": "escalate"
            },
            "form": {
              "fields": [
                {
                  "name": "Comment",
                  "dataType": "string",
                  "isRequired": true,
                  "label": "Yonetim Karari"
                },
                {
                  "name": "StrategicJustification",
                  "dataType": "string",
                  "isRequired": true,
                  "label": "Stratejik Gerekce"
                }
              ]
            },
            "onApprove": "onay",
            "onReject": "red"
          },
          {
            "key": "onay",
            "type": "end",
            "name": "Onaylandi",
            "outcome": "completed"
          },
          {
            "key": "red",
            "type": "end",
            "name": "Reddedildi",
            "outcome": "rejected"
          }
        ]
      }
    },
    {
      "name": "Tedarikci Onay Sureci",
      "code": "SUPPLIER_ONAY",
      "modelName": "Supplier",
      "triggerEvent": "onUpdate",
      "isEnabled": true,
      "$test": "T-32 — paralel adim ve red semantigi",
      "triggerConditionJson": [
        {
          "field": "Status",
          "operator": "eq",
          "value": "PendingApproval"
        }
      ],
      "definitionJson": {
        "startStep": "inceleme",
        "entityStatusMap": {
          "inceleme": "Incelemede",
          "yonetim": "Yonetim Onayinda"
        },
        "steps": [
          {
            "key": "inceleme",
            "type": "parallel",
            "name": "Ticari ve Mali Inceleme",
            "mode": "all",
            "branches": [
              {
                "key": "ticari",
                "name": "Ticari Inceleme",
                "assignment": {
                  "mode": "role",
                  "roleId": 2
                },
                "sla": {
                  "dueHours": 72,
                  "escalateAfterHours": 120,
                  "onTimeout": "escalate"
                },
                "form": {
                  "fields": [
                    {
                      "name": "CommercialNote",
                      "dataType": "string",
                      "isRequired": true,
                      "label": "Ticari Degerlendirme"
                    },
                    {
                      "name": "ReferenceChecked",
                      "dataType": "boolean",
                      "isRequired": true,
                      "label": "Referans Kontrolu Yapildi"
                    }
                  ]
                }
              },
              {
                "key": "mali",
                "name": "Mali Inceleme",
                "assignment": {
                  "mode": "role",
                  "roleId": 4
                },
                "sla": {
                  "dueHours": 72,
                  "escalateAfterHours": 120,
                  "onTimeout": "escalate"
                },
                "form": {
                  "fields": [
                    {
                      "name": "TaxNumberVerified",
                      "dataType": "boolean",
                      "isRequired": true,
                      "label": "Vergi No Dogrulandi"
                    },
                    {
                      "name": "IbanVerified",
                      "dataType": "boolean",
                      "isRequired": true,
                      "label": "IBAN Dogrulandi"
                    },
                    {
                      "name": "CreditRating",
                      "dataType": "string",
                      "isRequired": false,
                      "label": "Kredi Notu"
                    }
                  ]
                }
              }
            ],
            "onComplete": "yonetim",
            "onAnyReject": ""
          },
          {
            "key": "yonetim",
            "type": "approval",
            "name": "Yonetim Onayi",
            "assignment": {
              "mode": "role",
              "roleId": 9
            },
            "sla": {
              "dueHours": 120,
              "escalateAfterHours": 168,
              "onTimeout": "escalate"
            },
            "onApprove": "",
            "onReject": ""
          }
        ]
      }
    },
    {
      "name": "Satin Alma Siparisi Onayi",
      "code": "PO_ONAY",
      "modelName": "PurchaseOrder",
      "triggerEvent": "onUpdate",
      "isEnabled": true,
      "triggerConditionJson": [
        {
          "field": "Status",
          "operator": "eq",
          "value": "PendingApproval"
        }
      ],
      "definitionJson": {
        "startStep": "purchasing",
        "entityStatusMap": {
          "purchasing": "Satin Alma Muduru Onayinda",
          "finance": "Finans Onayinda"
        },
        "steps": [
          {
            "key": "purchasing",
            "type": "approval",
            "name": "Satin Alma Muduru Onayi",
            "assignment": {
              "mode": "role",
              "roleId": 2
            },
            "sla": {
              "dueHours": 24,
              "escalateAfterHours": 48,
              "onTimeout": "escalate"
            },
            "onApprove": "finance",
            "onReject": ""
          },
          {
            "key": "finance",
            "type": "approval",
            "name": "Finans Onayi",
            "assignment": {
              "mode": "role",
              "roleId": 4
            },
            "sla": {
              "dueHours": 48,
              "escalateAfterHours": 72,
              "onTimeout": "autoApprove"
            },
            "onApprove": "",
            "onReject": ""
          }
        ]
      },
      "$warning": "onTimeout=autoApprove: 48 saat icinde karar verilmezse sistem gorevi ONAYLANMIS sayar, yoruma 'Sure asimi - otomatik sonuclandirildi.' yazar, CompletedBy=null birakir. Gercek kurulumda 'escalate' tercih edilmeli."
    },
    {
      "name": "Fatura Uyusmazligi Onayi",
      "code": "INVOICE_EXCEPTION",
      "modelName": "SupplierInvoice",
      "triggerEvent": "onUpdate",
      "isEnabled": true,
      "triggerConditionJson": [
        {
          "field": "Status",
          "operator": "eq",
          "value": "Exception"
        },
        {
          "field": "MatchStatus",
          "operator": "ne",
          "value": "ThreeWayOk"
        }
      ],
      "definitionJson": {
        "startStep": "finance",
        "entityStatusMap": {
          "finance": "Finans Muduru Incelemesinde"
        },
        "steps": [
          {
            "key": "finance",
            "type": "approval",
            "name": "Uyusmazlik Degerlendirmesi",
            "assignment": {
              "mode": "role",
              "roleId": 4
            },
            "sla": {
              "dueHours": 24,
              "escalateAfterHours": 48,
              "onTimeout": "escalate"
            },
            "form": {
              "fields": [
                {
                  "name": "Resolution",
                  "dataType": "enum",
                  "isRequired": true,
                  "label": "Karar",
                  "enumValues": "Accepted|Rejected|CreditNoteRequested"
                },
                {
                  "name": "Comment",
                  "dataType": "string",
                  "isRequired": true,
                  "label": "Gerekce"
                }
              ]
            },
            "onApprove": "",
            "onReject": ""
          }
        ]
      },
      "$warning": "Tetikleyici MatchStatus alanina bakar ve o alan 3-way matching'in ciktisidir — platformda hesaplanmiyor (G-02). Akis kurulur ama tetikleyicisi ELLE doldurulan bir alandir."
    }
  ],
  "knownLimitations": [
    "Kosul satirlari AND/OR (hepsi/herhangi biri) destekler; parantezli karisik ifade icin formul modu kullanilir.",
    "Organizasyonel atama yok: 'talebin departman muduru' ifade edilemez; role atama TUM departman mudurlerini havuza koyar.",
    "Kayit tetigi outbox isleme anindaki GUNCEL degere bakar (yazildigi anki degere degil)."
  ]
}
