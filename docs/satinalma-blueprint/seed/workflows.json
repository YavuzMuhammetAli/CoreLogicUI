    {
      "name": "Fatura Uyusmazligi Onayi",
      "code": "INVOICE_EXCEPTION",
      "modelName": "SupplierInvoice",
      "triggerEvent": "onUpdate",
      "isEnabled": true,
      "triggerConditionJson": [
        { "field": "Status", "operator": "eq", "value": "Exception" },
        { "field": "MatchStatus", "operator": "ne", "value": "ThreeWayOk" }
      ],
      "definitionJson": {
        "startStep": "finance",
        "entityStatusMap": { "finance": "Finans Muduru Incelemesinde" },
        "steps": [
          {
            "key": "finance", "type": "approval", "name": "Uyusmazlik Degerlendirmesi",
            "assignment": { "mode": "role", "roleId": 4 },
            "sla": { "dueHours": 24, "escalateAfterHours": 48, "onTimeout": "escalate" },
            "form": { "fields": [
              { "name": "Resolution", "dataType": "enum", "isRequired": true, "label": "Karar",
                "enumValues": "Accepted|Rejected|CreditNoteRequested" },
              { "name": "Comment", "dataType": "string", "isRequired": true, "label": "Gerekce" }
            ]},
            "onApprove": "", "onReject": ""
          }
        ]
      },
      "$warning": "Tetikleyici MatchStatus alanina bakar ve o alan 3-way matching'in ciktisidir — platformda hesaplanmiyor (G-02). Akis kurulur ama tetikleyicisi ELLE doldurulan bir alandir."
    }
