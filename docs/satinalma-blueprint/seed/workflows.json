    {
      "name": "Tedarikci Onay Sureci",
      "code": "SUPPLIER_ONAY",
      "modelName": "Supplier",
      "triggerEvent": "onUpdate",
      "isEnabled": true,
      "$test": "T-32 — paralel adim ve red semantigi",
      "triggerConditionJson": [
        { "field": "Status", "operator": "eq", "value": "PendingApproval" }
      ],
      "definitionJson": {
        "startStep": "inceleme",
        "entityStatusMap": { "inceleme": "Incelemede", "yonetim": "Yonetim Onayinda" },
        "steps": [
          {
            "key": "inceleme", "type": "parallel", "name": "Ticari ve Mali Inceleme",
            "mode": "all",
            "branches": [
              {
                "key": "ticari", "name": "Ticari Inceleme",
                "assignment": { "mode": "role", "roleId": 2 },
                "sla": { "dueHours": 72, "escalateAfterHours": 120, "onTimeout": "escalate" },
                "form": { "fields": [
                  { "name": "CommercialNote", "dataType": "string", "isRequired": true, "label": "Ticari Degerlendirme" },
                  { "name": "ReferenceChecked", "dataType": "boolean", "isRequired": true, "label": "Referans Kontrolu Yapildi" }
                ]}
              },
              {
                "key": "mali", "name": "Mali Inceleme",
                "assignment": { "mode": "role", "roleId": 4 },
                "sla": { "dueHours": 72, "escalateAfterHours": 120, "onTimeout": "escalate" },
                "form": { "fields": [
                  { "name": "TaxNumberVerified", "dataType": "boolean", "isRequired": true, "label": "Vergi No Dogrulandi" },
                  { "name": "IbanVerified", "dataType": "boolean", "isRequired": true, "label": "IBAN Dogrulandi" },
                  { "name": "CreditRating", "dataType": "string", "isRequired": false, "label": "Kredi Notu" }
                ]}
              }
            ],
            "onComplete": "yonetim",
            "onAnyReject": ""
          },
          {
            "key": "yonetim", "type": "approval", "name": "Yonetim Onayi",
            "assignment": { "mode": "role", "roleId": 9 },
            "sla": { "dueHours": 120, "escalateAfterHours": 168, "onTimeout": "escalate" },
            "onApprove": "", "onReject": ""
          }
        ]
      }
    },

